{
  "manifest_version": 3,
  "name": "Market Research Terminal for X/Twitter",
  "version": "1.0.0",
  "description": "Scan visible X/Twitter news, filter market-moving items, and optionally analyze them with OpenAI for trader context.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.openai.com/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Market Research Terminal",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "utils.js",
        "scoring.js",
        "cockpit.js",
        "storage.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
